# =============================================================================
# AgentForge Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AgentForge
APP_VERSION=1.0.0
ENVIRONMENT=development
# Set to false in production
DEBUG=true

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# Add your production frontend domain here before deploying.
# -----------------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://yourapp.com"]

# -----------------------------------------------------------------------------
# Database
# Default: SQLite for local development (no setup required).
# For production: use PostgreSQL.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./agentforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agentforge

# -----------------------------------------------------------------------------
# Authentication
# IMPORTANT: Generate a strong random secret before deploying to production.
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# LLM Providers (optional — only required when AI planning is enabled)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Local LLM (Ollama)
# OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# Browser Engine
# -----------------------------------------------------------------------------
BROWSER_NAME=chromium
# Set HEADLESS=true for server/CI environments, false for local debugging
HEADLESS=true
# Timeout in milliseconds for browser operations
BROWSER_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Logging
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO